layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
        children
    }
    pane split_direction="vertical" size="40%" {
        pane name="2ndBrain" cwd="/Users/raviyadav/Documents/ObsidianSyncedVaults/SecondBrain"
        pane name="TRACE" {
            command "bash"
            args "-c" "exec nvim $(ls -t $HOME/Documents/ObsidianSyncedVaults/SecondBrain/daily-logs/$(date +%Y)/*.md 2>/dev/null | head -1)"
        }
    }
    pane name="LCARS" size="60%" focus=true cwd="/Users/raviyadav/Documents/ObsidianSyncedVaults/SecondBrain" {
        command "claude"
    }
}
