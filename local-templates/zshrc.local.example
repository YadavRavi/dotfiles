# ~/.zshrc.local — Machine-specific overrides
# Copy to ~/.zshrc.local and edit for this machine.
# This file is sourced by ~/.zshrc and is gitignored.

# --- Identity / Paths ---
# Obsidian vault location (used by ops, oo alias, sesh scripts)
export OSTRICH_VAULT="$HOME/Documents/ObsidianSyncedVaults/SecondBrain"

# HomeLab repo path (used by engineering.sh session script)
export HOMELAB_PATH="$HOME/HomeLab/rani-homelab-v2"

# --- SSH Agent ---
# 1Password SSH agent (comment out if not using 1Password)
export SSH_AUTH_SOCK=~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock

