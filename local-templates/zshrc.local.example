# --- Homebrew extras ---
# Uncomment if using Homebrew's curl over system curl
# export PATH="/opt/homebrew/opt/curl/bin:$PATH"

# --- Hardware ---
# Brother QL-800 label printer (comment out if not connected)
# export BROTHER_QL_PRINTER="usb://0x04f9:0x209b"
# export BROTHER_QL_MODEL="QL-800"

