# Brewfile — single file, profile-gated via HOMEBREW_DOTFILES_PROFILE env var.
# Homebrew strips env vars without the HOMEBREW_ prefix, so a plain DOTFILES_PROFILE arrives as nil.
# Usage:
#   HOMEBREW_DOTFILES_PROFILE=personal brew bundle --file=~/dotfiles/bootstrap/Brewfile
#   HOMEBREW_DOTFILES_PROFILE=work     brew bundle --file=~/dotfiles/bootstrap/Brewfile
profile = ENV["HOMEBREW_DOTFILES_PROFILE"]

# --- Core (all machines) ---
brew "zsh"
brew "starship"
brew "zoxide"
brew "fzf"
brew "bat"
brew "eza"
brew "fd"
brew "ripgrep"
brew "yazi"
brew "glow"      # yazi: Markdown preview via piper.yazi
brew "resvg"     # yazi: default SVG previewer
brew "jq"
brew "git"
brew "jj"
brew "stow"
brew "neovim"
brew "zellij"
brew "herdr"         # TUI mux (fallback; the Herdr desktop app is the main driver)
brew "tmux"          # dormant fallback
brew "lazygit"
brew "git-delta"

cask "ghostty"

# --- Personal-only ---
if profile == "personal"
  brew "1password-cli"
  cask "1password"
  cask "obsidian"
end

# --- Work-only ---
if profile == "work"
  # ~/Applications: no admin rights needed, same path as personal (manual install there).
  cask "herdr-app", args: { appdir: "~/Applications" }
end
